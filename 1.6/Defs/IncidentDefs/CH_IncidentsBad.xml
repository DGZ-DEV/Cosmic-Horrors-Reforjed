    <defName>ROM_RaidCosmicHorrors</defName>
    <label>horror assault</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>CosmicHorror.IncidentWorker_RaidCosmicHorrors</workerClass>
    <baseChance>5.0</baseChance>
    <category>ThreatBig</category>
    <pointsScaleable>true</pointsScaleable>
