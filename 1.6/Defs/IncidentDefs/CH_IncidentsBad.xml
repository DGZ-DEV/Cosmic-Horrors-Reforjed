  </IncidentDef>
  <IncidentDef>
    <defName>ROM_StarVampireAttack</defName>
    <label>star vampire attack</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>CosmicHorror.IncidentWorker_StarVampireAttack</workerClass>
    <category>ThreatBig</category>
    <letterLabel>A chill</letterLabel>
    <letterText>An eerie calm has washed over the land. Something is coming.</letterText>
    <letterDef>ThreatBig</letterDef>
    <baseChance>2.3</baseChance>
    <pointsScaleable>true</pointsScaleable>
    <minThreatPoints>450</minThreatPoints>
    <minRefireDays>4</minRefireDays>
  </IncidentDef>
  <IncidentDef>
    <defName>ROM_DarkYoung</defName>
    <label>dark young</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>CosmicHorror.IncidentWorker_DarkYoung</workerClass>
    <category>ThreatSmall</category>
    <earliestDay>10</earliestDay>
    <baseChance>2.1</baseChance>
    <pointsScaleable>true</pointsScaleable>
    <minThreatPoints>250</minThreatPoints>
    <minRefireDays>8</minRefireDays>
  </IncidentDef>
  <IncidentDef>
    <defName>ROM_ChthonianPit</defName>
    <label>strange sinkhole (chthonian)</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>CosmicHorror.IncidentWorker_PitChthonian</workerClass>
    <earliestDay>14</earliestDay>
    <letterLabel>Strange Sinkhole</letterLabel>
    <letterText>A massive sinkhole has opened up near your colony.\n\nA colossal beast writhes beneath, clawing at the minds of your colony with unseen fingers.\n\nIt demands a sacrifice. Feed it or destroy it quickly.</letterText>
    <letterDef>ThreatBig</letterDef>
    <baseChance>1.5</baseChance>
    <minRefireDays>14</minRefireDays>
    <tags>
      <li>Chthonian</li>
    </tags>
    <refireCheckTags>
      <li>Chthonian</li>
    </refireCheckTags>
    <category>ThreatBig</category>
    <pointsScaleable>true</pointsScaleable>
    <minThreatPoints>450</minThreatPoints>
    <mechClusterBuilding>ROM_PitChthonian</mechClusterBuilding>
  </IncidentDef>
  <IncidentDef>
